# Base de datos y administrador inicial
ECOTECH_DB_PATH=datos/ecotech.db
ECOTECH_ADMIN_USUARIO=admin
ECOTECH_ADMIN_PASSWORD=cambiar_esta_clave

# Sesion: minutos de inactividad antes de pedir login otra vez
SESION_MINUTOS=15

# APIs externas (ninguna necesita llave, por eso no hay claves aqui)
API_CLIMA_GEO_URL=https://geocoding-api.open-meteo.com/v1/search
API_CLIMA_URL=https://api.open-meteo.com/v1/forecast
API_CAMBIO_URL=https://mindicador.cl/api

# Cliente HTTP: timeout en segundos, intentos maximos (1 a 4) y espera base del backoff
API_TIMEOUT_SEGUNDOS=8
API_MAX_INTENTOS=4
API_ESPERA_BASE_SEGUNDOS=1

# Ciudades que se actualizan con "Actualizar datos externos" (formato Ciudad:PAIS)
CIUDADES_SINCRONIZAR=Concepción:CL,Santiago:CL
